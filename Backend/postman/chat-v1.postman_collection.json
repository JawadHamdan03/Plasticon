{
  "info": {
    "name": "Plasticon Chat V1",
    "description": "Chat endpoints focused on unread counts and mark-as-read.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "groupId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Chat - Unread Counts Per Group",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chat/groups/unread-counts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "groups",
            "unread-counts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Chat - Mark Group As Read",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/groups/{{groupId}}/mark-as-read",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "groups",
            "{{groupId}}",
            "mark-as-read"
          ]
        }
      },
      "response": []
    }
  ]
}
